# Moss Cloud credentials (free tier: https://moss.dev)
# Copy this file to .env.local and fill in your values.
# WITHOUT these, Pulse911 still runs end-to-end using a clearly-labeled
# deterministic local fallback — no synthetic latency numbers are ever shown.
VITE_MOSS_PROJECT_ID=your_project_id_here
VITE_MOSS_PROJECT_KEY=your_project_key_here

# HiDevs LLM Gateway — get your arena key from the hackathon arena page
# (app.hidevs.xyz → API KEY → Reveal). Powers the async AI Dispatcher Coach.
# The app works fully without it; the coach panel shows an honest "inactive" state.
VITE_HIDEVS_LLM_URL=https://llm.hidevs.xyz/v1/chat/completions
VITE_HIDEVS_LLM_KEY=your_arena_key_here
VITE_HIDEVS_LLM_MODEL=gemini-3.5-flash-lite
