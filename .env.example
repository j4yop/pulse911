# Moss Cloud credentials (free tier: https://moss.dev)
# Copy this file to .env.local and fill in your values.
# WITHOUT these, Pulse911 still runs end-to-end using a clearly-labeled
# deterministic local fallback — no synthetic latency numbers are ever shown.
VITE_MOSS_PROJECT_ID=your_project_id_here
VITE_MOSS_PROJECT_KEY=your_project_key_here
